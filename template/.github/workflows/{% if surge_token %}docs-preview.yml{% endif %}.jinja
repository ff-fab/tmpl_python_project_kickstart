# Documentation preview for pull requests
#
# - On PRs (opened/synchronize/reopened): builds docs and deploys to surge.sh
# - On PR close: tears down the surge.sh preview
#
# Preview URL: {{ repo_name }}-pr-{N}.surge.sh
# Requires: SURGE_TOKEN repository secret (fork PRs gracefully skip deploy)

name: Documentation Preview

on:
  pull_request:
    types: [opened, synchronize, reopened]
    paths:
      - 'docs/**'
      - 'overrides/**'
      - 'zensical.toml'
      - 'uv.lock'
  pull_request_target:
    types: [closed]
    paths:
      - 'docs/**'
      - 'overrides/**'
      - 'zensical.toml'
      - 'uv.lock'

{% raw %}
env:
  DEVCONTAINER_IMAGE: ghcr.io/{% endraw %}{{ github_org }}/{{ project_name }}{% raw %}-devcontainer
  SURGE_DOMAIN: {% endraw %}{{ repo_name }}{% raw %}-pr-${{ github.event.pull_request.number }}.surge.sh

permissions:
  contents: read
  packages: read
  pull-requests: write

concurrency:
  group: docs-preview-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  build:
    name: Build Documentation
    if: github.event.action != 'closed'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - name: Prepare runner for devcontainer
        run: mkdir -p ~/.ssh

      - name: Log in to GHCR (for devcontainer cache)
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4.6.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build documentation inside devcontainer
        uses: devcontainers/ci@513af61f4de4f75d37e4438f184ba4358f0fc1ca # v0.3.1900000450
        env:
          # Read by devcontainer.json's build.args via ${localEnv:...} — skips
          # installing Claude Code on a cache-miss rebuild since CI never
          # invokes `claude`. Local devcontainer builds default to installing it.
          INSTALL_CLAUDE_CODE: 'false'
        with:
          cacheFrom: ${{ env.DEVCONTAINER_IMAGE }}
          runCmd: task docs:build

      - name: Validate build output
        run: |
          if [ ! -f site/index.html ]; then
            echo "::error::Documentation build produced no pages (site/index.html missing)"
            exit 1
          fi

      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: docs-preview
          path: site
          retention-days: 3

  deploy:
    name: Deploy Preview
    if: github.event.action != 'closed'
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Download docs-preview artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: docs-preview
          path: site

      - name: Install and deploy to Surge
        id: surge
        env:
          SURGE_TOKEN: ${{ secrets.SURGE_TOKEN }}
        run: |
          if [ -z "$SURGE_TOKEN" ]; then
            echo "::warning::SURGE_TOKEN not set — skipping preview deploy (expected for fork PRs)"
            echo "deployed=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          npm install -g surge
          surge site/ "$SURGE_DOMAIN" --token "$SURGE_TOKEN"
          echo "deployed=true" >> "$GITHUB_OUTPUT"

      - name: Build changed-pages list
        id: changed
        if: steps.surge.outputs.deployed == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          SURGE_DOMAIN: ${{ env.SURGE_DOMAIN }}
        run: |
          links=""
          while IFS= read -r file; do
            url=""
            if [[ "$file" == docs/* && "$file" == *.md ]]; then
              slug="${file#docs/}"
              slug="${slug%.md}"
              [[ "$slug" == "index" ]] && url="/"
              [[ "$slug" == */index ]] && url="/${slug%/index}/"
              [[ -z "$url" ]] && url="/${slug}/"
            fi
            if [ -n "$url" ]; then
              links="${links}- [${file}](https://${SURGE_DOMAIN}${url})"$'\n'
            fi
          done < <(gh pr diff "$PR_NUMBER" --name-only | grep -E '\.(md|toml)$' || true)
          if [ -z "$links" ]; then
            links="_No individual page links detected — browse the preview URL directly._"
          fi
          {
            echo "links<<LINKS_EOF"
            echo "$links"
            echo "LINKS_EOF"
          } >> "$GITHUB_OUTPUT"

      - name: Find existing preview comment
        id: find
        if: steps.surge.outputs.deployed == 'true'
        uses: peter-evans/find-comment@b30e6a3c0ed37e7c023ccd3f1db5c6c0b0c23aad # v4.0.0
        with:
          issue-number: ${{ github.event.pull_request.number }}
          comment-author: 'github-actions[bot]'
          body-includes: Documentation Preview

      - name: Post or update preview comment
        if: steps.surge.outputs.deployed == 'true'
        uses: peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9 # v5.0.0
        with:
          issue-number: ${{ github.event.pull_request.number }}
          comment-id: ${{ steps.find.outputs.comment-id }}
          edit-mode: replace
          body: |
            ## 📖 Documentation Preview

            🔗 **Preview URL:** https://${{ env.SURGE_DOMAIN }}

            ### Changed Pages
            ${{ steps.changed.outputs.links }}
            _Last updated: ${{ github.event.pull_request.updated_at }} · Build #${{ github.run_number }}_

  teardown:
    name: Teardown Preview
    # pull_request_target runs in base branch context — safe because this job never
    # checks out or executes PR code, only tears down the Surge domain
    if: github.event.action == 'closed'
    runs-on: ubuntu-latest
    steps:
      - name: Teardown Surge preview
        env:
          SURGE_TOKEN: ${{ secrets.SURGE_TOKEN }}
        run: |
          if [ -z "$SURGE_TOKEN" ]; then
            echo "::warning::SURGE_TOKEN not set — skipping teardown"
            exit 0
          fi
          npm install -g surge
          surge teardown "$SURGE_DOMAIN" --token "$SURGE_TOKEN"

      - name: Find existing preview comment
        id: find
        uses: peter-evans/find-comment@b30e6a3c0ed37e7c023ccd3f1db5c6c0b0c23aad # v4.0.0
        with:
          issue-number: ${{ github.event.pull_request.number }}
          comment-author: 'github-actions[bot]'
          body-includes: Documentation Preview

      - name: Update comment to closed state
        if: steps.find.outputs.comment-id != ''
        uses: peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9 # v5.0.0
        with:
          comment-id: ${{ steps.find.outputs.comment-id }}
          edit-mode: replace
          body: |
            ## 📖 Documentation Preview

            ~~https://${{ env.SURGE_DOMAIN }}~~

            Preview has been removed (PR closed).
{% endraw %}
